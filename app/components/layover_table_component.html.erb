<section data-section="layovers">
  <h2 class="mb-2 text-section-sm leading-snug font-bold text-slate-900 sm:text-section"><%= t(".title") %></h2>
  <p class="mb-6 max-w-[46em] text-slate-600"><%= t(".note") %></p>
  <div class="@container relative">
    <div class="overflow-x-auto">
      <table class="data-table min-w-[660px]">
        <thead>
          <tr>
            <th class="text-left"><%= t(".direction") %></th>
            <th class="text-left"><%= t(".last_stop") %></th>
            <th class="text-left"><%= t(".nature") %></th>
            <th><%= t(".count") %></th>
            <th>p10</th>
            <th>p50</th>
            <th>p90</th>
            <th><%= t(".short", minutes: short_minutes) %></th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr data-direction="<%= row.go_back %>" data-end-nature="<%= nature(row) %>">
              <td class="text-left"><%= t(".directions.#{row.go_back}") %></td>
              <td class="text-left"><%= row.stop_name %></td>
              <td class="text-left"><%= nature_tag(t(".natures.#{nature(row)}")) %></td>
              <td><%= row.n_layovers %></td>
              <% row.percentiles.each do |value| %>
                <td><%= minutes(value) %></td>
              <% end %>
              <td><%= share(row.short_share) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%# 只在框比表格窄、需要橫向捲動時，才在右緣提示還有內容 %>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-9 bg-linear-to-r from-white/0 to-white @min-[660px]:hidden"></div>
  </div>
  <% if pass_through? %>
    <p data-pass-through-note class="mt-3 max-w-[46em] text-note text-slate-500 sm:mt-3.5"><%= t(".pass_through_note") %></p>
  <% end %>
</section>
