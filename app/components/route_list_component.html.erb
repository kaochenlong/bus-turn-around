<section data-section="routes" class="mt-12">
  <h2 class="mb-4 text-xl font-bold text-slate-900"><%= t(".title") %></h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    <% entries.each do |entry| %>
      <li>
        <% if (route_day = entry.route_day) %>
          <%= link_to route_page_path(entry.route_id), data: { route: entry.route_id, latest_day: route_day.day.iso8601 },
                      class: "block h-full rounded-lg border border-slate-200 bg-white p-4 transition-colors hover:border-teal-600 hover:bg-teal-50/40" do %>
            <p class="text-lg leading-tight font-bold text-slate-900"><%= route_day.route_name %> <span class="font-route-figure font-medium text-slate-500"><%= entry.route_id %></span></p>
            <p class="mt-1 text-slate-600"><%= route_day.departure %>－<%= route_day.destination %></p>
            <p class="mt-3 text-sm text-teal-700"><%= t(".latest", day: day_label(route_day.day)) %></p>
          <% end %>
        <% else %>
          <div data-route="<%= entry.route_id %>" data-no-data class="h-full rounded-lg border border-dashed border-slate-300 p-4 text-slate-500">
            <p class="font-route-figure text-lg leading-tight font-medium"><%= entry.route_id %></p>
            <p class="mt-3 text-sm"><%= t(".no_data") %></p>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
  <p class="mt-3 text-sm text-slate-500"><%= t(".note") %></p>
</section>
