<section data-section="summary" class="flex">
  <div data-trips="<%= @summary.trips %>" class="flex-1 sm:flex-none sm:pr-9">
    <div class="mb-1.5 text-note text-slate-600 sm:mb-2"><%= t(".trips") %></div>
    <div class="font-route-figure text-stat-sm leading-none font-semibold text-slate-900 sm:text-stat"><%= @summary.trips %><span class="ml-1.5 font-route text-body font-medium text-slate-500"><%= t(".unit") %></span></div>
  </div>
  <div data-complete-trips="<%= @summary.complete_trips %>" class="flex-1 border-l border-slate-200 pl-5 sm:flex-none sm:pl-9">
    <div class="mb-1.5 text-note text-slate-600 sm:mb-2"><%= t(".complete_trips") %></div>
    <div class="font-route-figure text-stat-sm leading-none font-semibold text-slate-900 sm:text-stat"><%= @summary.complete_trips %><span class="ml-1.5 font-route text-body font-medium text-slate-500"><%= t(".unit") %></span></div>
  </div>
</section>
