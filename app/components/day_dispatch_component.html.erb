<%# 當天調度：排班時藏著，沒有腳本就一直藏著；瀏覽器開始或繼續一天之後打開，排班的部分同時藏起來。
    這裡只有骨架、文案與伺服器知道的路線；當天的計畫與修改只在瀏覽器裡，數字、列與清單由 app/frontend/timetable/day_view.js
    照下面的 template 與 data-labels 的字填，車只寫單子上的車號 %>
<section data-day-dispatch hidden data-route-id="<%= route_id %>" data-labels="<%= labels_json %>"
         class="flex flex-col gap-4">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div class="flex flex-col gap-1">
      <%= eyebrow(t(".eyebrow")) %>
      <h1 class="text-section-sm leading-tight font-bold text-slate-900 sm:text-section"><%= route_name %>　<span data-slot="date"></span></h1>
      <p data-slot="basis" class="text-label-sm text-slate-600"></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%# 計畫的班表連到班表頁：瀏覽器照顯示的那一天把計畫依據填進網址，打開就是同一份單子 %>
      <a href="<%= timetable_path %>" data-plan-timetable class="<%= BUTTON_CLASSES %> inline-flex items-center"><%= t(".plan_timetable") %></a>
      <%# 當天紀錄：印出來，或匯出成兩個 CSV，各一個按鈕；都在瀏覽器裡做，伺服器什麼都不收 %>
      <button type="button" data-print-record class="<%= BUTTON_CLASSES %>"><%= t(".print_record") %></button>
      <button type="button" data-export="changes" class="<%= BUTTON_CLASSES %>"><%= t(".export_changes") %></button>
      <button type="button" data-export="sheets" class="<%= BUTTON_CLASSES %>"><%= t(".export_sheets") %></button>
      <button type="button" data-restart class="<%= BUTTON_CLASSES %>"><%= t(".restart") %></button>
    </div>
  </header>

  <%# 存不進這台電腦的瀏覽器時（無痕視窗、被擋、滿了）才出現；改的照樣算 %>
  <p data-not-kept hidden role="status" class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-label text-slate-800"><%= t(".not_kept") %></p>

  <%# 頁首四個數字：只報數字，不標好壞 %>
  <dl class="flex flex-wrap gap-2 text-label-sm text-slate-700">
    <% %w[swaps typed waiting shortest].each do |figure| %>
      <div class="inline-flex items-baseline gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5">
        <dt><%= t(".figures.#{figure}") %></dt>
        <dd class="inline-flex items-baseline gap-1">
          <span data-figure="<%= figure %>" class="font-route-figure text-lead font-bold text-slate-900"></span><%= t(".figures.#{figure}_unit") %>
          <% if figure == "shortest" %><span data-slot="shortest-detail"></span><% end %>
        </dd>
      </div>
    <% end %>
  </dl>

  <%# 選取的那一趟：瀏覽器照時間軸的 template 放在這裡，在時間軸上面 %>
  <div data-slot="trip-actions" class="empty:hidden"></div>

  <%# 主畫面是時間軸，用滿寬度 %>
  <%= render DayTimelineComponent.new(stop_names: @stop_names, actions:) %>

  <%# 側欄照 01 的排法在時間軸下面：左邊發車表，右邊現在在這一端的車、記下回到時刻與修改清單；放不下兩欄時疊成一欄 %>
  <div class="flex flex-wrap items-start gap-4">
    <section class="flex min-w-0 flex-[999_1_640px] flex-col gap-2.5 rounded-lg border border-slate-200 bg-white p-4">
      <div role="group" aria-label="<%= t(".ends_label") %>" class="flex flex-wrap gap-2">
        <% ends.each do |an_end| %>
          <button type="button" data-end="<%= an_end.go_back %>" data-name="<%= an_end.name %>" aria-pressed="false" class="<%= END_BUTTON_CLASSES %>"><%= an_end.label %></button>
        <% end %>
      </div>
      <p class="text-label-sm text-slate-600"><%= t(".departures_note") %></p>
      <%# 發車表的格子沒有地方寫原因：先打在這裡，下一個換車或改發車時刻一起記下，記下之後清空 %>
      <label class="flex flex-col gap-1 text-tick text-slate-600">
        <%= t(".change_reason") %>
        <input type="text" data-change-reason placeholder="<%= t(".record.reason_placeholder") %>" class="<%= FIELD_CLASSES %> w-full max-w-sm">
      </label>
      <%# 發車表放在自己的捲動框裡，表頭留在框的上緣：捲到某一班時頁面不跟著動。手機上放不下，框裡也能左右捲。
          表頭的線用陰影畫，捲動時才跟著表頭 %>
      <div data-departures-frame class="max-h-105 overflow-auto border-t border-slate-200">
        <table class="w-full min-w-150 table-fixed border-collapse text-label text-slate-900">
          <colgroup>
            <col class="w-19"><col class="w-22"><col class="w-45"><col><col class="w-19"><col class="w-23">
          </colgroup>
          <thead>
            <tr class="text-left text-tick font-semibold text-slate-600">
              <th data-column="departure" class="<%= HEADER_CLASSES %> px-1.5"><%= t(".columns.departure") %></th>
              <th data-column="planned" class="<%= HEADER_CLASSES %> px-1.5"><%= t(".columns.planned") %></th>
              <th data-column="vehicle" class="<%= HEADER_CLASSES %> px-1.5"><%= t(".columns.vehicle") %></th>
              <th data-column="arrival" data-slot="arrival-column" class="<%= HEADER_CLASSES %> px-1.5"></th>
              <th data-column="stop" class="<%= HEADER_CLASSES %> px-1.5 text-right"><%= t(".columns.stop") %></th>
              <th data-column="status" class="<%= HEADER_CLASSES %> px-1.5"><%= t(".columns.status") %></th>
            </tr>
          </thead>
          <tbody data-slot="departures"></tbody>
        </table>
      </div>
    </section>

    <aside class="flex min-w-0 flex-[1_1_320px] flex-col gap-3">
      <section class="<%= CARD_CLASSES %>">
        <h2 data-slot="standing-heading" class="text-note font-bold text-slate-900"></h2>
        <ul data-slot="standing" class="flex flex-col gap-1.5"></ul>
        <p data-standing-none hidden class="text-label-sm text-slate-500"><%= t(".standing_none") %></p>
        <h3 class="mt-1.5 text-label-sm font-semibold text-slate-600"><%= t(".arriving_heading") %></h3>
        <ul data-slot="arriving" class="grid grid-cols-[72px_56px_minmax(0,1fr)] gap-y-1 text-label-sm"></ul>
        <p data-arriving-none hidden class="text-label-sm text-slate-500"><%= t(".arriving_none") %></p>
      </section>

      <section class="<%= CARD_CLASSES %>">
        <h2 data-slot="record-heading" class="text-note font-bold text-slate-900"></h2>
        <%# 不是送出的表單：瀏覽器記下之後存在這台電腦 %>
        <form data-record novalidate class="flex flex-col gap-2.5">
          <div class="flex flex-wrap gap-2.5">
            <label class="flex flex-col gap-1 text-tick text-slate-600">
              <%= t(".record.vehicle") %>
              <select data-record-vehicle class="<%= FIELD_CLASSES %> min-w-24"></select>
            </label>
            <label class="flex flex-col gap-1 text-tick text-slate-600">
              <%= t(".record.time") %>
              <input type="text" data-record-time inputmode="numeric" placeholder="HH:MM" class="<%= FIELD_CLASSES %> w-22 font-route-figure text-note">
            </label>
            <label class="flex flex-[1_1_140px] flex-col gap-1 text-tick text-slate-600">
              <%= t(".record.reason") %>
              <input type="text" data-record-reason placeholder="<%= t(".record.reason_placeholder") %>" class="<%= FIELD_CLASSES %> w-full">
            </label>
          </div>
          <button type="submit" class="<%= PRIMARY_BUTTON_CLASSES %> self-start"><%= t(".record.submit") %></button>
          <p data-record-message id="day-record-message" hidden role="alert" class="text-label text-red-700"></p>
        </form>
      </section>

      <section class="<%= CARD_CLASSES %>">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 data-slot="changes-heading" class="text-note font-bold text-slate-900"></h2>
          <button type="button" data-undo class="<%= BUTTON_CLASSES %>"><%= t(".undo") %></button>
        </div>
        <ol data-slot="changes" class="grid grid-cols-[48px_minmax(0,1fr)] gap-x-2 gap-y-1.5 text-label-sm"></ol>
        <p data-changes-none hidden class="text-label-sm text-slate-500"><%= t(".changes_none") %></p>
      </section>
    </aside>
  </div>

  <%# 當天紀錄：螢幕上不出現，印的時候取代上面的畫面。第一頁是摘要（頁首、四個數字、每台車的休息、修改清單），
      接著一車一頁、單子下面印註記，最後一頁是資料限制，再接 layout 的顯名聲明。數值照 design 的 Design Source；
      值由瀏覽器照存著的那一天填 %>
  <div data-day-record class="hidden text-[11pt] leading-[1.35] text-black print:block">
    <section data-record-summary class="flex flex-col gap-[5mm]">
      <header class="flex flex-col gap-[1mm]">
        <p class="text-[10pt] font-semibold tracking-[0.04em]"><%= t(".day_record.eyebrow") %></p>
        <h2 class="text-[18pt] leading-[1.25] font-bold"><%= route_name %>　<span data-slot="record-date"></span></h2>
        <p data-slot="record-basis" class="text-[10pt]"></p>
        <p class="text-[10pt]"><%= t(".day_record.entered") %></p>
      </header>
      <dl class="flex flex-wrap gap-[2mm]">
        <% %w[swaps typed waiting shortest].each do |figure| %>
          <div class="inline-flex items-baseline gap-[1.5mm] border-[0.5pt] border-black px-[3mm] py-[1.5mm] text-[10pt]">
            <dt><%= t(".figures.#{figure}") %></dt>
            <dd class="inline-flex items-baseline gap-[1mm]">
              <span data-record-figure="<%= figure %>" class="font-route-figure text-[14pt] font-bold"></span><%= t(".figures.#{figure}_unit") %>
              <% if figure == "shortest" %><span data-slot="record-shortest-detail"></span><% end %>
            </dd>
          </div>
        <% end %>
      </dl>
      <section class="flex flex-col gap-[2mm]">
        <h3 class="text-[11pt] font-bold"><%= t(".day_record.credits_heading", hours: WINDOW_HOURS) %></h3>
        <%# 一列 6 格、照車號；格線由清單畫上與左、每一格畫右與下 %>
        <ul data-slot="record-credits" class="grid grid-cols-6 border-t-[0.5pt] border-l-[0.5pt] border-black"></ul>
      </section>
      <section class="flex flex-col gap-[2mm]">
        <h3 data-slot="record-changes-heading" class="text-[11pt] font-bold"></h3>
        <table class="w-full table-fixed border-collapse text-[10pt] leading-[1.3]">
          <colgroup><col class="w-[20mm]"><col><col class="w-[62mm]"><col class="w-[18mm]"></colgroup>
          <thead>
            <tr>
              <% %w[at change reason].each do |column| %>
                <th class="<%= RECORD_HEADER_CLASSES %> text-left"><%= t(".day_record.columns.#{column}") %></th>
              <% end %>
              <th class="<%= RECORD_HEADER_CLASSES %> text-center"><%= t(".day_record.columns.undone") %></th>
            </tr>
          </thead>
          <tbody data-slot="record-changes"></tbody>
        </table>
        <p data-record-changes-none hidden class="text-[10pt]"><%= t(".day_record.changes_none") %></p>
      </section>
    </section>
    <%# 一車一頁：用班表頁同一套單子，只給路線名，標題下那一行由瀏覽器照存著的那一天寫 %>
    <div data-record-sheets></div>
    <%= render TimetableSheetComponent.new(route_name:) %>
    <%= render DayRecordLimitationsComponent.new %>
  </div>

  <%# 發車表的一列：發車可以打時刻、派車是選單；換過車時派車底下寫原排；在時間軸上選了的那一班畫框。
      時刻被退回或換車不成立時，下一列寫原因 %>
  <template data-departure-row>
    <tr data-trip class="border-b border-slate-100 data-[status=departed]:text-slate-500 data-[status=next]:bg-teal-50 data-selected:outline-2 data-selected:-outline-offset-2 data-selected:outline-slate-900">
      <td class="h-12 px-1.5 in-data-[status=departed]:h-10">
        <input type="text" data-control="departure" inputmode="numeric"
               class="w-16 rounded border border-transparent bg-transparent px-1 py-0.5 font-route-figure text-note hover:border-slate-300 aria-[invalid=true]:border-red-600 in-data-[status=next]:text-[17px] in-data-[status=next]:font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">
      </td>
      <td data-slot="planned" class="px-1.5 text-slate-500"></td>
      <td class="px-1.5 py-1">
        <select data-control="vehicle" class="<%= FIELD_CLASSES %> w-full in-data-swapped:border-2 in-data-swapped:border-teal-700"></select>
        <span data-slot="swapped" class="block text-tick text-teal-700"></span>
      </td>
      <td class="px-1.5"><span data-slot="arrival" class="font-route-figure text-note text-slate-700"></span><span data-slot="recorded" hidden class="ml-1.5 text-tick text-slate-600"><%= t(".recorded") %></span></td>
      <td data-slot="stop" class="px-1.5 text-right font-route-figure text-note in-data-[status=next]:text-[17px] in-data-[status=next]:font-bold in-data-[status=next]:text-teal-700"></td>
      <td data-slot="status" class="px-1.5 text-label-sm in-data-[status=next]:font-semibold in-data-[status=planned]:text-slate-500 in-data-[status=waiting]:font-semibold in-data-[status=waiting]:text-amber-800"></td>
    </tr>
  </template>
  <template data-row-message>
    <tr data-row-message><td colspan="6" class="px-1.5 pb-2"><p role="alert" class="text-label text-red-700"></p></td></tr>
  </template>
  <template data-now-line>
    <tr data-now-line>
      <td colspan="6" class="h-5.5 px-1.5">
        <span class="flex items-center gap-2 text-tick font-semibold text-teal-700"><span aria-hidden="true" class="h-0.5 flex-1 bg-teal-700"></span><span data-slot="now"></span><span aria-hidden="true" class="h-0.5 flex-1 bg-teal-700"></span></span>
      </td>
    </tr>
  </template>
  <template data-standing-item>
    <li class="flex items-center gap-2.5 rounded-md border border-slate-300 px-2.5 py-2"><span data-slot="vehicle" class="shrink-0 font-bold whitespace-nowrap text-slate-900"></span><span data-slot="detail" class="text-slate-700"></span></li>
  </template>
  <template data-arriving-item>
    <li class="contents"><span data-slot="vehicle" class="font-semibold whitespace-nowrap text-slate-900"></span><span data-slot="arrival" class="font-route-figure text-label"></span><span data-slot="next" class="text-slate-600"></span></li>
  </template>
  <template data-change-item>
    <li class="contents"><span data-slot="at" class="font-route-figure text-label font-semibold"></span><span class="in-data-undone:text-slate-500"><span data-slot="text" class="in-data-undone:line-through"></span><span data-slot="reason" class="in-data-undone:line-through"></span><span data-slot="undone" hidden class="ml-1.5 rounded bg-slate-100 px-1.5 text-tick text-slate-600"><%= t(".undone") %></span></span></li>
  </template>
  <%# 印出來的紀錄：每台車的休息一格、修改清單一列（已復原的寫在最後一欄，字不劃線）、一張單下面的註記 %>
  <template data-record-credit>
    <li class="flex items-baseline justify-between gap-[2mm] border-r-[0.5pt] border-b-[0.5pt] border-black px-[2mm] py-[1.5mm] text-[10pt] leading-[1.3]">
      <span data-slot="vehicle" class="font-semibold"></span>
      <span class="inline-flex items-baseline gap-[1.5mm]"><span data-slot="now" class="font-route-figure text-[12pt] font-bold"></span><span data-slot="planned" class="text-[9pt]"></span></span>
    </li>
  </template>
  <template data-record-change>
    <tr class="break-inside-avoid">
      <td data-slot="at" class="<%= RECORD_CELL_CLASSES %> font-route-figure font-semibold whitespace-nowrap"></td>
      <td data-slot="text" class="<%= RECORD_CELL_CLASSES %>"></td>
      <td data-slot="reason" class="<%= RECORD_CELL_CLASSES %>"></td>
      <td class="<%= RECORD_CELL_CLASSES %> text-center whitespace-nowrap"><span data-slot="undone" hidden><%= t(".undone") %></span></td>
    </tr>
  </template>
  <template data-sheet-notes>
    <ul data-sheet-notes class="mt-[3mm] text-[10pt] leading-[1.35]"></ul>
  </template>
</section>
