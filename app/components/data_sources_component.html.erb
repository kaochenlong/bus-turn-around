<section data-section="sources" class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-600">
  <h2 class="mb-2 font-semibold"><%= t(".title") %></h2>
  <p><%= t(".body") %></p>
  <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
    <% DATASETS.each do |name, url| %>
      <li><%= link_to t(".datasets.#{name}"), url, class: "text-teal-700 underline underline-offset-2 hover:text-teal-900" %></li>
    <% end %>
  </ul>
</section>
