<%# 手機上滿版寬、不換行，放不下就橫向捲動 %>
<nav data-section-nav aria-label="<%= t(".label") %>"
     class="sticky top-0 z-10 -mx-4 flex gap-2 overflow-x-auto border-b border-slate-200 bg-slate-50 px-4 py-2.5 sm:mx-0 sm:px-0 sm:py-3">
  <% SECTIONS.each do |section| %>
    <a href="#<%= section %>"
       class="shrink-0 rounded-full border border-slate-300 bg-white px-4 py-2 text-table font-medium whitespace-nowrap text-slate-700 select-none hover:border-slate-400 hover:text-slate-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-teal-700 sm:py-1.75"><%= t(".sections.#{section}") %></a>
  <% end %>
</nav>
