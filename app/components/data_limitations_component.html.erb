<section data-section="limitations" class="text-slate-600 <%= @styles.fetch(:section) %>">
  <h2 class="<%= @styles.fetch(:title) %>"><%= title %></h2>
  <ul class="list-disc pl-5 <%= @styles.fetch(:list) %>">
    <% items.each do |item| %>
      <li><%= item %></li>
    <% end %>
  </ul>
</section>
