<section data-section="mrt-overlap" class="mb-10">
  <h2 class="mb-1 text-[24px] leading-snug font-bold text-slate-900"><%= t(".title") %></h2>
  <p class="mb-5 max-w-[46em] text-slate-600"><%= t(".note") %></p>

  <% if @mrt_overlap.needs_reload? %>
    <p data-needs-reload class="rounded border border-amber-300 bg-amber-50 p-4"><%= t(".needs_reload") %></p>
  <% else %>
    <table data-shares class="mb-6 w-full max-w-xl text-sm tabular-nums">
      <thead class="text-slate-500">
        <tr>
          <th class="text-left font-normal"><%= t(".direction") %></th>
          <th class="text-right font-normal"><%= t(".stops") %></th>
          <% thresholds.each do |meters| %>
            <th class="text-right font-normal"><%= t(".within", meters:) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% directions.each do |direction| %>
          <tr data-direction="<%= direction.go_back %>">
            <td><%= t(".directions.#{direction.go_back}") %></td>
            <td class="text-right"><%= direction.n_stops %></td>
            <% thresholds.each do |meters| %>
              <td class="text-right <%= "font-semibold" if meters == stretch_threshold %>"><%= share(direction.shares.fetch(meters)) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h3 class="mb-2 text-[19px] font-semibold text-teal-800"><%= t(".stretches", meters: stretch_threshold) %></h3>
    <% if stretches.empty? %>
      <p class="text-slate-600"><%= t(".no_stretch") %></p>
    <% end %>
    <% stretches.each do |stretch| %>
      <div data-stretch="<%= stretch_key(stretch) %>" class="mb-5">
        <p class="mb-1 font-medium">
          <%= t(".stretch", direction: t(".directions.#{stretch.go_back}"), first: stretch.first_seq, last: stretch.last_seq,
                            first_stop: stretch.first_stop, last_stop: stretch.last_stop, count: stretch.n_stops) %>
        </p>
        <table class="w-full max-w-xl text-sm tabular-nums">
          <thead class="text-slate-500">
            <tr>
              <th class="text-left font-normal"><%= t(".band") %></th>
              <th class="text-right font-normal"><%= t(".trips") %></th>
              <th class="text-right font-normal"><%= t(".median") %></th>
              <th class="text-right font-normal">p90</th>
            </tr>
          </thead>
          <tbody>
            <% sorted_loads(stretch).each do |load| %>
              <tr>
                <td><%= t(".bands.#{load[:band]}") %></td>
                <td class="text-right"><%= load[:n_trips] %></td>
                <td class="text-right"><%= decimal(load[:median]) %></td>
                <td class="text-right"><%= decimal(load[:p90]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <p data-mrt-exits-day="<%= @mrt_overlap.mrt_exits_day&.iso8601 %>" class="text-xs text-slate-500">
      <%= t(".snapshot", day: @mrt_overlap.mrt_exits_day&.iso8601) %>
    </p>
  <% end %>
</section>
