<%# 不是一張卡，但區塊導覽與重點數字也連到這裡，一樣讓出導覽的高度 %>
<section id="mrt" data-section="mrt-overlap" class="scroll-mt-20">
  <%# 跟沿線人數圖同一張卡，標題是卡內的小標題層級 %>
  <h3 class="mb-2 text-subsection leading-snug font-bold text-slate-900"><%= t(".title") %></h3>
  <p class="mb-6 max-w-[46em] text-slate-600"><%= t(".note") %></p>

  <% if @mrt_overlap.needs_reload? %>
    <p data-needs-reload class="rounded border border-amber-300 bg-amber-50 p-4"><%= t(".needs_reload") %></p>
  <% else %>
    <table data-shares class="data-table max-w-[680px]">
      <thead>
        <tr>
          <th class="text-left"><%= t(".direction") %></th>
          <th><%= t(".stops") %></th>
          <% thresholds.each do |meters| %>
            <th class="whitespace-normal sm:whitespace-nowrap <%= "font-semibold text-slate-900" if meters == stretch_threshold %>"><%= t(".within", meters:) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% directions.each do |direction| %>
          <tr data-direction="<%= direction.go_back %>">
            <td class="text-left"><%= t(".directions.#{direction.go_back}") %></td>
            <td><%= direction.n_stops %></td>
            <% thresholds.each do |meters| %>
              <td class="<%= "font-semibold text-slate-900" if meters == stretch_threshold %>"><%= share(direction.shares.fetch(meters)) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h4 class="mt-7.5 mb-3 text-subsection font-semibold text-teal-800"><%= t(".stretches", meters: stretch_threshold) %></h4>
    <% if stretches.empty? %>
      <p class="text-slate-600"><%= t(".no_stretch") %></p>
    <% else %>
      <div class="space-y-7">
        <% stretches.each do |stretch| %>
          <div data-stretch="<%= stretch_key(stretch) %>">
            <p class="mb-1.5 font-medium text-slate-800">
              <%= t(".stretch", direction: t(".directions.#{stretch.go_back}"), first: stretch.first_seq, last: stretch.last_seq,
                                first_stop: stretch.first_stop, last_stop: stretch.last_stop, count: stretch.n_stops) %>
            </p>
            <table class="data-table max-w-[680px]">
              <thead>
                <tr>
                  <th class="text-left"><%= t(".band") %></th>
                  <th><%= t(".trips") %></th>
                  <th><%= t(".median") %></th>
                  <th>p90</th>
                </tr>
              </thead>
              <tbody>
                <% sorted_loads(stretch).each do |load| %>
                  <tr>
                    <td class="text-left"><%= t(".bands.#{load[:band]}") %></td>
                    <td><%= load[:n_trips] %></td>
                    <td><%= decimal(load[:median]) %></td>
                    <td><%= decimal(load[:p90]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>

    <p data-mrt-exits-day="<%= @mrt_overlap.mrt_exits_day&.iso8601 %>" class="mt-5.5 text-label text-slate-500">
      <%= t(".snapshot", day: @mrt_overlap.mrt_exits_day&.iso8601) %>
    </p>
  <% end %>
</section>
