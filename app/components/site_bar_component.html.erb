<% text_link = "inline-flex min-h-11 items-center rounded-sm text-table font-medium text-slate-600 select-none hover:text-slate-900 " \
               "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700" %>
<header data-site-bar class="border-b border-slate-200 bg-white font-route">
  <div class="page-column flex items-center justify-between gap-4 py-3.5">
    <%= link_to helpers.root_path, class: "inline-flex rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700" do %>
      <%= image_tag "turnaround-logo.webp", alt: "", width: 640, height: 219, class: "h-12 w-auto", aria: { hidden: true } %>
      <span class="sr-only"><%= t("site.name") %></span>
    <% end %>
    <div class="flex items-center gap-5 sm:gap-7">
      <% if timetable_link? %>
        <%# 班表頁上是目前這一頁：標 aria-current，字色深一點 %>
        <%= link_to t(".timetable"), timetable_path, aria: { current: timetable_current }, class: [ text_link, ("text-slate-900" if timetable_current) ] %>
      <% end %>
      <%= link_to t(".about"), ABOUT_URL, class: text_link %>
    </div>
  </div>
</header>
