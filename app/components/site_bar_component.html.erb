<header data-site-bar class="border-b border-slate-200 bg-white font-route">
  <div class="page-column flex items-center justify-between py-3.5">
    <%= link_to helpers.root_path, class: "inline-flex rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700" do %>
      <%= image_tag "turnaround-logo.webp", alt: "", width: 640, height: 219, class: "h-12 w-auto", aria: { hidden: true } %>
      <span class="sr-only"><%= t("site.name") %></span>
    <% end %>
    <%= link_to t(".about"), ABOUT_URL,
                class: "inline-flex min-h-11 items-center rounded-sm text-table font-medium text-slate-600 select-none hover:text-slate-900 " \
                       "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700" %>
  </div>
</header>
