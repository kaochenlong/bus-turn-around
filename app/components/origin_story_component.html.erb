<section data-section="origin" class="mt-12 grid gap-y-6 lg:grid-cols-2 lg:gap-x-14">
  <div>
    <p class="text-note font-medium tracking-[0.02em] text-teal-700"><%= t(".eyebrow") %></p>
    <h2 class="mt-2 text-section-sm leading-snug font-bold tracking-[0.01em] text-slate-900 sm:text-section"><%= t(".heading") %></h2>
    <p class="mt-3"><%= t(".summary") %></p>
  </div>
  <figure class="self-start rounded-2xl border border-slate-200 bg-white p-5 lg:row-span-2">
    <figcaption class="px-1 leading-normal font-bold text-slate-900"><%= t(".day") %></figcaption>
    <ol class="mt-3">
      <li class="flex items-baseline gap-4 border-b border-slate-100 px-1 py-2.25">
        <time datetime="06:50" class="w-14 shrink-0 font-route-figure text-subsection leading-[1.2] font-semibold text-slate-900">06:50</time>
        <span class="text-slate-700"><%= t(".depart") %></span>
      </li>
      <li class="flex items-baseline gap-4 px-1 py-2.25">
        <time datetime="09:50" class="w-14 shrink-0 font-route-figure text-subsection leading-[1.2] font-semibold text-teal-700">09:50</time>
        <span class="font-medium text-slate-900"><%= t(".back") %></span>
      </li>
      <li data-interval class="my-0.5 flex flex-wrap items-baseline gap-x-3 gap-y-0.5 rounded-[10px] bg-teal-50 px-3.5 py-3">
        <span class="font-route-figure text-figure-card leading-[1.15] font-semibold text-teal-700"><%= t(".interval") %></span>
        <span class="text-note leading-normal text-teal-800"><%= t(".interval_quote") %></span>
      </li>
      <li class="flex items-baseline gap-4 px-1 py-2.25">
        <time datetime="10:00" class="w-14 shrink-0 font-route-figure text-subsection leading-[1.2] font-semibold text-teal-700">10:00</time>
        <span class="font-medium text-slate-900"><%= t(".depart") %></span>
      </li>
    </ol>
  </figure>
  <div class="space-y-3">
    <% if route_links? %>
      <ul class="flex flex-wrap gap-2">
        <% ROUTE_LINKS.each do |anchor, key| %>
          <li>
            <%= link_to route_section_path(anchor),
                        class: "inline-flex min-h-11 items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 text-table leading-snug font-medium " \
                               "text-teal-700 transition-colors hover:border-teal-600 hover:bg-teal-50/40" do %>
              <%= t(".#{key}") %>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="text-label leading-relaxed text-slate-500">
      <%= t(".source_html", title: link_to(t(".article_title"), ARTICLE_URL, class: "text-teal-700 underline underline-offset-2 hover:text-teal-900"),
                            date: tag.time("2026-07-31", datetime: "2026-07-31")) %>
    </p>
  </div>
</section>
