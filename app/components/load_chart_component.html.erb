<section data-section="load-chart" x-data="{ band: '<%= DEFAULT_BAND %>', direction: 0 }">
  <%= eyebrow(t(".eyebrow")) %>
  <h2 class="mb-2 text-section-sm leading-snug font-bold text-slate-900 sm:text-section"><%= t(".title") %></h2>
  <p class="mb-6 text-slate-600"><%= t(".note") %></p>

  <div x-cloak data-band-switch role="group" aria-label="<%= t(".band_picker") %>"
       class="mb-2.5 flex gap-0.5 rounded-[10px] border border-slate-200 bg-slate-100 p-0.75 sm:mb-5 sm:inline-flex">
    <% BANDS.each do |band| %>
      <button type="button" value="<%= band %>" x-on:click="band = '<%= band %>'" x-bind:aria-pressed="band === '<%= band %>'"
              x-bind:class="band === '<%= band %>' ? 'bg-white font-semibold text-slate-900 shadow-[0_1px_2px_rgba(15,23,42,0.14)]' : 'font-medium text-slate-600 hover:text-slate-900'"
              class="flex min-h-11 flex-1 items-center justify-center rounded-lg text-base select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 sm:flex-none sm:px-4.5">
        <%= t(".bands.#{band}") %>
      </button>
    <% end %>
  </div>

  <%# 640px 以下的每站一列一次只看一個方向，預設去程；跟時段一樣只是頁面上的狀態，不改網址。
      沒有 JS 時切換按鈕藏著（x-cloak），兩個方向的列都在 %>
  <div x-cloak data-direction-switch role="group" aria-label="<%= t(".direction_picker") %>"
       class="mb-4.5 flex gap-0.5 rounded-[10px] border border-slate-200 bg-slate-100 p-0.75 sm:hidden">
    <% charts.each do |chart| %>
      <button type="button" value="<%= chart.go_back %>" x-on:click="direction = <%= chart.go_back %>" x-bind:aria-pressed="direction === <%= chart.go_back %>"
              x-bind:class="direction === <%= chart.go_back %> ? 'bg-white font-semibold text-slate-900 shadow-[0_1px_2px_rgba(15,23,42,0.14)]' : 'font-medium text-slate-600 hover:text-slate-900'"
              class="flex min-h-11 flex-1 items-center justify-center rounded-lg text-base select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">
        <%= t(".directions.#{chart.go_back}") %>
      </button>
    <% end %>
  </div>

  <% charts.each do |chart| %>
    <%# 每個方向一組：640px 以上是 SVG 的線，以下改成每站一列。兩份都由伺服器輸出，用同一批中位數與同一個刻度；
        列的屬性名（data-row-*）跟 SVG 的分開，數點的測試不會數到兩份。
        hoveredSpan 是滑鼠指到的那一段，圖上那一段與清單那一列一起變深，兩個方向各記各的；沒有 JS 時沒有這個效果 %>
    <div data-direction="<%= chart.go_back %>" data-scale-top="<%= scale_top(chart) %>" x-data="{ hoveredSpan: null }" class="mb-6 min-w-0 last:mb-0 sm:mb-7">
      <figure class="max-sm:hidden">
        <figcaption class="mb-2 font-semibold text-slate-800"><%= t(".directions.#{chart.go_back}") %></figcaption>
        <div class="@container relative">
          <div class="overflow-x-auto">
            <svg viewBox="0 0 <%= LoadChartComponent::WIDTH %> <%= LoadChartComponent::HEIGHT %>" class="pointer-events-none h-auto w-full min-w-[720px]" role="img"
                 aria-label="<%= t(".aria", direction: t(".directions.#{chart.go_back}"), first: chart.stops.first.stop_name, last: chart.stops.last.stop_name) %>">
              <%# 底色帶上方只畫編號，名字在圖下方的清單：路段短、靠得近的時候，名字會疊在一起或被切掉。
                  整張圖不接收滑鼠、只有每一段接收：折線與格線畫在底色帶上面，指到線上時底色帶才不會以為滑鼠離開了 %>
              <% chart.ranges.each.with_index(1) do |range, number| %>
                <g data-span-from="<%= range.first %>" data-span-to="<%= range.last %>" data-span-number="<%= number %>"
                   data-first-stop="<%= stop_name(chart, range.first) %>" data-last-stop="<%= stop_name(chart, range.last) %>"
                   x-on:mouseenter="hoveredSpan = <%= number %>" x-on:mouseleave="hoveredSpan = null" x-bind:data-active="hoveredSpan === <%= number %>"
                   class="group pointer-events-auto">
                  <rect x="<%= span_x(chart, range) %>" y="<%= LoadChartComponent::TOP %>" width="<%= span_width(chart, range) %>"
                        height="<%= plot_height %>" class="fill-sky-100 transition-colors group-data-active:fill-sky-200" />
                  <circle data-span-marker cx="<%= span_center_x(chart, range) %>" cy="<%= LoadChartComponent::MARKER_Y %>"
                          r="<%= LoadChartComponent::MARKER_RADIUS %>" class="fill-sky-800" />
                  <text x="<%= span_center_x(chart, range) %>" y="<%= LoadChartComponent::MARKER_Y + 5 %>" text-anchor="middle"
                        class="fill-white text-label-sm font-semibold"><%= number %></text>
                </g>
              <% end %>

              <% [ 0, scale_top(chart) / 2, scale_top(chart) ].each do |tick| %>
                <line x1="<%= LoadChartComponent::LEFT %>" x2="<%= LoadChartComponent::WIDTH - LoadChartComponent::RIGHT %>"
                      y1="<%= y(chart, tick) %>" y2="<%= y(chart, tick) %>" class="<%= tick.zero? ? "stroke-slate-400" : "stroke-slate-200" %>" />
                <text x="<%= LoadChartComponent::LEFT - 6 %>" y="<%= y(chart, tick) + 5 %>" text-anchor="end" class="fill-slate-500 text-label-sm"><%= tick %></text>
              <% end %>

              <% BANDS.each do |band| %>
                <g data-band="<%= band %>" x-show="band === '<%= band %>'" <%= "x-cloak" unless band == DEFAULT_BAND %>>
                  <% segments(chart, band).each do |segment| %>
                    <polyline data-segment points="<%= polyline(chart, segment) %>" fill="none" stroke-width="2" stroke-linejoin="round" class="stroke-teal-700" />
                  <% end %>
                  <% points(chart, band).each do |seq, median| %>
                    <circle data-seq="<%= seq %>" data-median="<%= median %>" cx="<%= x(chart, seq) %>" cy="<%= y(chart, median) %>" r="2.5" class="fill-teal-700" />
                  <% end %>
                </g>
              <% end %>

              <text x="<%= LoadChartComponent::LEFT %>" y="<%= LoadChartComponent::HEIGHT - 10 %>" class="fill-slate-600 text-label"><%= chart.stops.first.stop_name %></text>
              <text x="<%= LoadChartComponent::WIDTH - LoadChartComponent::RIGHT %>" y="<%= LoadChartComponent::HEIGHT - 10 %>" text-anchor="end"
                    class="fill-slate-600 text-label"><%= chart.stops.last.stop_name %></text>
              <text x="4" y="<%= LoadChartComponent::TOP - 10 %>" class="fill-slate-500 text-label-sm"><%= t(".people") %></text>
            </svg>
          </div>
          <%# 只在框比圖窄、需要橫向捲動時，才在右緣提示還有內容 %>
          <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-9 bg-linear-to-r from-white/0 to-white @min-[720px]:hidden"></div>
        </div>
        <%# 路段名稱列在圖下方、橫向捲動那一層外面，照卡片寬度換行，不跟著圖捲走。編號圓用 HTML 畫：這一塊的每一個 svg
            都要在可以橫向捲動的框裡。圓不給螢幕報讀，圖是 role="img"，唸出編號對不到任何東西 %>
        <% if chart.ranges.any? %>
          <ol data-span-legend class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1.5">
            <% chart.ranges.each.with_index(1) do |range, number| %>
              <%# 內距配等量的負外距：沒指到時字的位置不變，變深時淺底色有一點邊 %>
              <li data-span-number="<%= number %>" data-first-stop="<%= stop_name(chart, range.first) %>" data-last-stop="<%= stop_name(chart, range.last) %>"
                  x-on:mouseenter="hoveredSpan = <%= number %>" x-on:mouseleave="hoveredSpan = null" x-bind:data-active="hoveredSpan === <%= number %>"
                  class="-mx-1.5 -my-0.5 flex items-center gap-2 rounded-md px-1.5 py-0.5 text-label leading-[1.4] font-medium text-sky-800 transition-colors data-active:bg-sky-100">
                <span aria-hidden="true" class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-sky-800 text-label-sm font-semibold text-white"><%= number %></span>
                <%= t(".span", first: stop_name(chart, range.first), last: stop_name(chart, range.last)) %>
              </li>
            <% end %>
          </ol>
        <% end %>
      </figure>
      <div x-show="direction === <%= chart.go_back %>" class="sm:hidden">
        <%# 有方向切換時，方向名稱只留給螢幕報讀；沒有 JS 時照常顯示，分得出兩個方向 %>
        <p x-bind:class="'sr-only'" class="mb-2 font-semibold text-slate-800"><%= t(".directions.#{chart.go_back}") %></p>
        <% BANDS.each do |band| %>
          <div data-row-band="<%= band %>" x-show="band === '<%= band %>'" <%= "x-cloak" unless band == DEFAULT_BAND %>>
            <div class="flex items-end gap-2 px-2 pb-1.5 text-label-sm text-slate-500">
              <span class="w-37.5 shrink-0"><%= t(".rows_stop") %></span>
              <span class="flex flex-1 justify-between"><span>0</span><span><%= scale_top(chart) %></span></span>
              <span class="w-9.5 shrink-0 text-right"><%= t(".people") %></span>
            </div>
            <div class="border-t border-slate-200">
              <% stop_rows(chart, band).each do |row| %>
                <% if row.span %>
                  <div data-row-span data-first-stop="<%= row.stop_name %>" data-last-stop="<%= stop_name(chart, row.span.last) %>"
                       class="bg-sky-100 px-2 pt-1.5 pb-0.5 text-label leading-[1.4] font-medium text-sky-800"><%= t(".span", first: row.stop_name, last: stop_name(chart, row.span.last)) %></div>
                <% end %>
                <%= tag.div data: { row_seq: row.seq, row_median: row.median, row_near: (true if row.near) }, class: [ "flex min-h-8 items-center gap-2 px-2", ("bg-sky-100" if row.near) ] do %>
                  <span class="w-37.5 shrink-0 text-note leading-tight text-slate-700"><%= row.stop_name %></span>
                  <span class="flex h-3 flex-1 rounded-[3px] bg-slate-100"><% if row.median %><span data-row-bar class="block h-3 rounded-[3px] bg-teal-700" style="<%= bar_style(chart, row.median) %>"></span><% end %></span>
                  <span class="w-9.5 shrink-0 text-right text-note text-slate-800"><%= row.median ? format("%.1f", row.median) : NONE %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
        <p class="mt-3 text-note text-slate-500"><%= t(".rows_note") %></p>
      </div>
    </div>
  <% end %>
</section>
