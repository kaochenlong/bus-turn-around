<section data-section="load-chart" class="mb-10" x-data="{ band: '<%= DEFAULT_BAND %>' }">
  <h2 class="mb-1 text-[24px] leading-snug font-bold text-slate-900"><%= t(".title") %></h2>
  <p class="mb-4 max-w-[46em] text-slate-600"><%= t(".note") %></p>

  <div x-cloak role="group" aria-label="<%= t(".band_picker") %>" class="mb-4 flex flex-wrap gap-2">
    <% BANDS.each do |band| %>
      <button type="button" x-on:click="band = '<%= band %>'" x-bind:aria-pressed="band === '<%= band %>'"
              x-bind:class="band === '<%= band %>' ? 'border-teal-700 bg-teal-700 text-white' : 'border-slate-300 text-slate-700 hover:border-teal-700'"
              class="rounded border px-3 py-1 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">
        <%= t(".bands.#{band}") %>
      </button>
    <% end %>
  </div>

  <% charts.each do |chart| %>
    <figure data-direction="<%= chart.go_back %>" data-scale-top="<%= scale_top(chart) %>" class="mb-8 min-w-0">
      <figcaption class="mb-2 font-medium text-slate-800"><%= t(".directions.#{chart.go_back}") %></figcaption>
      <div class="overflow-x-auto">
      <svg viewBox="0 0 <%= LoadChartComponent::WIDTH %> <%= LoadChartComponent::HEIGHT %>" class="h-auto w-full min-w-[600px]" role="img"
           aria-label="<%= t(".aria", direction: t(".directions.#{chart.go_back}"), first: chart.stops.first.stop_name, last: chart.stops.last.stop_name) %>">
        <% chart.ranges.each do |range| %>
          <g data-span-from="<%= range.first %>" data-span-to="<%= range.last %>"
             data-first-stop="<%= stop_name(chart, range.first) %>" data-last-stop="<%= stop_name(chart, range.last) %>">
            <rect x="<%= span_x(chart, range) %>" y="<%= LoadChartComponent::TOP %>" width="<%= span_width(chart, range) %>"
                  height="<%= plot_height %>" class="fill-sky-100" />
            <text x="<%= span_x(chart, range) + (span_width(chart, range) / 2) %>" y="<%= LoadChartComponent::TOP - 8 %>" text-anchor="middle"
                  class="fill-sky-800 text-[12px]"><%= t(".span", first: stop_name(chart, range.first), last: stop_name(chart, range.last)) %></text>
          </g>
        <% end %>

        <% [ 0, scale_top(chart) / 2, scale_top(chart) ].each do |tick| %>
          <line x1="<%= LoadChartComponent::LEFT %>" x2="<%= LoadChartComponent::WIDTH - LoadChartComponent::RIGHT %>"
                y1="<%= y(chart, tick) %>" y2="<%= y(chart, tick) %>" class="<%= tick.zero? ? "stroke-slate-400" : "stroke-slate-200" %>" />
          <text x="<%= LoadChartComponent::LEFT - 6 %>" y="<%= y(chart, tick) + 4 %>" text-anchor="end" class="fill-slate-500 text-[11px]"><%= tick %></text>
        <% end %>

        <% BANDS.each do |band| %>
          <g data-band="<%= band %>" x-show="band === '<%= band %>'" <%= "x-cloak" unless band == DEFAULT_BAND %>>
            <% segments(chart, band).each do |segment| %>
              <polyline data-segment points="<%= polyline(chart, segment) %>" fill="none" stroke-width="2" stroke-linejoin="round" class="stroke-teal-700" />
            <% end %>
            <% points(chart, band).each do |seq, median| %>
              <circle data-seq="<%= seq %>" data-median="<%= median %>" cx="<%= x(chart, seq) %>" cy="<%= y(chart, median) %>" r="2.5" class="fill-teal-700" />
            <% end %>
          </g>
        <% end %>

        <text x="<%= LoadChartComponent::LEFT %>" y="<%= LoadChartComponent::HEIGHT - 10 %>" class="fill-slate-600 text-[12px]"><%= chart.stops.first.stop_name %></text>
        <text x="<%= LoadChartComponent::WIDTH - LoadChartComponent::RIGHT %>" y="<%= LoadChartComponent::HEIGHT - 10 %>" text-anchor="end"
              class="fill-slate-600 text-[12px]"><%= chart.stops.last.stop_name %></text>
        <text x="4" y="<%= LoadChartComponent::TOP - 8 %>" class="fill-slate-500 text-[11px]"><%= t(".people") %></text>
      </svg>
      </div>
    </figure>
  <% end %>
</section>
