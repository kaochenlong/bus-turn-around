<section data-section="load-chart" x-data="{ band: '<%= DEFAULT_BAND %>' }">
  <h2 class="mb-2 text-section-sm leading-snug font-bold text-slate-900 sm:text-section"><%= t(".title") %></h2>
  <p class="mb-6 max-w-[46em] text-slate-600"><%= t(".note") %></p>

  <div x-cloak role="group" aria-label="<%= t(".band_picker") %>"
       class="mb-4.5 flex gap-0.5 rounded-[10px] border border-slate-200 bg-slate-100 p-0.75 sm:mb-5 sm:inline-flex">
    <% BANDS.each do |band| %>
      <button type="button" x-on:click="band = '<%= band %>'" x-bind:aria-pressed="band === '<%= band %>'"
              x-bind:class="band === '<%= band %>' ? 'bg-white font-semibold text-slate-900 shadow-[0_1px_2px_rgba(15,23,42,0.14)]' : 'font-medium text-slate-600 hover:text-slate-900'"
              class="flex min-h-11 flex-1 items-center justify-center rounded-lg text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 sm:flex-none sm:px-4.5">
        <%= t(".bands.#{band}") %>
      </button>
    <% end %>
  </div>

  <% charts.each do |chart| %>
    <figure data-direction="<%= chart.go_back %>" data-scale-top="<%= scale_top(chart) %>" class="mb-6 min-w-0 last:mb-0 sm:mb-7">
      <figcaption class="mb-2 font-semibold text-slate-800"><%= t(".directions.#{chart.go_back}") %></figcaption>
      <div class="@container relative">
        <div class="overflow-x-auto">
          <svg viewBox="0 0 <%= LoadChartComponent::WIDTH %> <%= LoadChartComponent::HEIGHT %>" class="h-auto w-full min-w-[720px]" role="img"
               aria-label="<%= t(".aria", direction: t(".directions.#{chart.go_back}"), first: chart.stops.first.stop_name, last: chart.stops.last.stop_name) %>">
            <% chart.ranges.each do |range| %>
              <g data-span-from="<%= range.first %>" data-span-to="<%= range.last %>"
                 data-first-stop="<%= stop_name(chart, range.first) %>" data-last-stop="<%= stop_name(chart, range.last) %>">
                <rect x="<%= span_x(chart, range) %>" y="<%= LoadChartComponent::TOP %>" width="<%= span_width(chart, range) %>"
                      height="<%= plot_height %>" class="fill-sky-100" />
                <text x="<%= span_x(chart, range) + (span_width(chart, range) / 2) %>" y="<%= LoadChartComponent::TOP - 10 %>" text-anchor="middle"
                      class="fill-sky-800 text-label"><%= t(".span", first: stop_name(chart, range.first), last: stop_name(chart, range.last)) %></text>
              </g>
            <% end %>

            <% [ 0, scale_top(chart) / 2, scale_top(chart) ].each do |tick| %>
              <line x1="<%= LoadChartComponent::LEFT %>" x2="<%= LoadChartComponent::WIDTH - LoadChartComponent::RIGHT %>"
                    y1="<%= y(chart, tick) %>" y2="<%= y(chart, tick) %>" class="<%= tick.zero? ? "stroke-slate-400" : "stroke-slate-200" %>" />
              <text x="<%= LoadChartComponent::LEFT - 6 %>" y="<%= y(chart, tick) + 5 %>" text-anchor="end" class="fill-slate-500 text-label-sm"><%= tick %></text>
            <% end %>

            <% BANDS.each do |band| %>
              <g data-band="<%= band %>" x-show="band === '<%= band %>'" <%= "x-cloak" unless band == DEFAULT_BAND %>>
                <% segments(chart, band).each do |segment| %>
                  <polyline data-segment points="<%= polyline(chart, segment) %>" fill="none" stroke-width="2" stroke-linejoin="round" class="stroke-teal-700" />
                <% end %>
                <% points(chart, band).each do |seq, median| %>
                  <circle data-seq="<%= seq %>" data-median="<%= median %>" cx="<%= x(chart, seq) %>" cy="<%= y(chart, median) %>" r="2.5" class="fill-teal-700" />
                <% end %>
              </g>
            <% end %>

            <text x="<%= LoadChartComponent::LEFT %>" y="<%= LoadChartComponent::HEIGHT - 10 %>" class="fill-slate-600 text-label"><%= chart.stops.first.stop_name %></text>
            <text x="<%= LoadChartComponent::WIDTH - LoadChartComponent::RIGHT %>" y="<%= LoadChartComponent::HEIGHT - 10 %>" text-anchor="end"
                  class="fill-slate-600 text-label"><%= chart.stops.last.stop_name %></text>
            <text x="4" y="<%= LoadChartComponent::TOP - 10 %>" class="fill-slate-500 text-label-sm"><%= t(".people") %></text>
          </svg>
        </div>
        <%# 只在框比圖窄、需要橫向捲動時，才在右緣提示還有內容 %>
        <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-9 bg-linear-to-r from-white/0 to-white @min-[720px]:hidden"></div>
      </div>
    </figure>
  <% end %>
</section>
