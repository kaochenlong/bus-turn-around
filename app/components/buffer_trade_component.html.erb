<turbo-frame id="buffer-trade" data-turbo-action="advance">
  <section data-section="buffer-trade" class="mb-10">
    <h2 class="mb-1 text-[24px] leading-snug font-bold text-slate-900"><%= t(".title") %></h2>
    <p class="mb-5 max-w-[46em] text-slate-600"><%= t(".note") %></p>

    <form action="<%= helpers.route_path(@coverage.route_id) %>" method="get" class="mb-5 flex max-w-xl flex-wrap items-center gap-x-4 gap-y-2"
          x-data="{ minutes: <%= @buffer_trade.minutes %> }">
      <input type="hidden" name="day" value="<%= @coverage.day.iso8601 %>">
      <input type="hidden" name="range" value="<%= @coverage.range %>">
      <label for="buffer-minutes" class="font-medium">
        <%= t(".buffer_html", minutes: tag.span(@buffer_trade.minutes, "data-value": "minutes", "x-text": "minutes")) %>
      </label>
      <input id="buffer-minutes" type="range" name="buffer" min="<%= minutes_range.min %>" max="<%= minutes_range.max %>" step="1"
             value="<%= @buffer_trade.minutes %>" x-model.number="minutes" x-on:change="$el.form.requestSubmit()"
             class="w-56 accent-teal-700">
      <button type="submit" x-init="$el.hidden = true" class="rounded border border-slate-300 px-3 py-1 text-sm"><%= t(".submit") %></button>
    </form>

    <div class="mb-4 max-w-[46em] space-y-1 text-slate-600">
      <p>
        <%= t(".coverage_html", days: tag.span(@buffer_trade.n_days, "data-value": "days"),
                                layovers: tag.span(@buffer_trade.n_layovers, "data-value": "layovers"),
                                trips: tag.span(@buffer_trade.n_trips, "data-value": "trips")) %>
      </p>
      <% if pass_through? %>
        <p data-pass-through>
          <%= t(".pass_through_html", layovers: tag.span(@buffer_trade.n_pass_through_layovers, "data-value": "pass-through-layovers")) %>
        </p>
      <% end %>
    </div>

    <% if layovers? %>
      <table class="w-full max-w-xl text-sm tabular-nums">
        <thead class="text-slate-500">
          <tr>
            <th class="text-left font-normal"></th>
            <th class="text-right font-normal"><%= t(".lower") %></th>
            <th class="text-right font-normal"><%= t(".upper") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= t(".vehicle_hours") %></td>
            <td class="text-right" data-value="vehicle-hours-lower"><%= decimal(@buffer_trade.vehicle_hours.lower) %></td>
            <td class="text-right" data-value="vehicle-hours-upper"><%= decimal(@buffer_trade.vehicle_hours.upper) %></td>
          </tr>
          <tr>
            <td><%= t(".peak_vehicles") %></td>
            <% peaks.each do |bound, peak| %>
              <td class="text-right" data-peak="<%= bound %>" data-hour="<%= peak.hour %>">
                <span data-vehicles><%= decimal(peak.vehicles) %></span>
                <span class="block text-xs text-slate-500"><%= hour_span(peak.hour) %></span>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
      <p class="mt-2 max-w-[46em] text-xs text-slate-500"><%= t(".bounds_note") %></p>

      <dl class="mt-4 grid max-w-xl grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
        <dt class="text-slate-500"><%= t(".achieved", minutes: @buffer_trade.minutes) %></dt>
        <dd class="tabular-nums" data-value="achieved"><%= share(@buffer_trade.achieved_share) %></dd>
        <dt class="text-slate-500"><%= t(".vehicles_per_day") %></dt>
        <dd class="tabular-nums" data-value="vehicles-per-day"><%= decimal(@buffer_trade.vehicles_per_day) %></dd>
      </dl>
    <% else %>
      <p data-no-layover class="rounded border border-amber-300 bg-amber-50 p-4"><%= t(".no_layover") %></p>
    <% end %>
  </section>
</turbo-frame>
