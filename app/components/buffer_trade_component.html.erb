<turbo-frame id="buffer-trade" data-turbo-action="advance">
  <section data-section="buffer-trade">
    <%= eyebrow(t(".eyebrow")) %>
    <h2 class="mb-2 text-section-sm leading-snug font-bold text-slate-900 sm:text-section"><%= t(".title") %></h2>
    <p class="mb-6 max-w-[46em] text-slate-600"><%= t(".note") %></p>

    <form action="<%= helpers.route_path(@coverage.route_id) %>" method="get"
          class="mb-5 flex max-w-[680px] flex-col gap-2.5 rounded-xl border border-slate-200 bg-slate-50 px-4.5 py-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:gap-y-3 sm:px-5.5 sm:py-4.5"
          x-data="{ minutes: <%= @buffer_trade.minutes %> }">
      <input type="hidden" name="day" value="<%= @coverage.day.iso8601 %>">
      <input type="hidden" name="range" value="<%= @coverage.range %>">
      <label for="buffer-minutes" class="font-semibold text-slate-900">
        <%= t(".buffer_html", minutes: tag.span(@buffer_trade.minutes, "data-value": "minutes", "x-text": "minutes")) %>
      </label>
      <input id="buffer-minutes" type="range" name="buffer" min="<%= minutes_range.min %>" max="<%= minutes_range.max %>" step="1"
             value="<%= @buffer_trade.minutes %>" x-model.number="minutes" x-on:change="$el.form.requestSubmit()"
             class="w-full accent-teal-700 sm:w-auto sm:grow sm:basis-60">
      <button type="submit" x-init="$el.hidden = true" class="self-start rounded border border-slate-300 bg-white px-3 py-1 text-note"><%= t(".submit") %></button>
    </form>

    <div class="mb-5.5 max-w-[46em] space-y-1 text-slate-600">
      <p>
        <%= t(".coverage_html", days: tag.span(@buffer_trade.n_days, "data-value": "days"),
                                layovers: tag.span(@buffer_trade.n_layovers, "data-value": "layovers"),
                                trips: tag.span(@buffer_trade.n_trips, "data-value": "trips")) %>
      </p>
      <% if pass_through? %>
        <p data-pass-through>
          <%= t(".pass_through_html", layovers: tag.span(@buffer_trade.n_pass_through_layovers, "data-value": "pass-through-layovers")) %>
        </p>
      <% end %>
    </div>

    <% if layovers? %>
      <%# 每一格的樣式：手機上是一個小框，640px 以上是欄裡的一列（標籤在左、數字在右） %>
      <% cell = "flex flex-col rounded-[10px] border border-slate-200 px-3.5 py-3 sm:mx-5.5 sm:grid sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-x-3 sm:rounded-none sm:border-0 sm:px-0 sm:py-0" %>
      <% bound_label = "text-label text-slate-500 sm:hidden" %>
      <% metric_label = "hidden text-table text-slate-600 sm:col-start-1 sm:row-start-1 sm:block" %>
      <% figure = "font-route-figure text-figure-sm leading-[1.15] font-semibold text-slate-900 sm:col-start-2 sm:row-start-1 sm:text-figure sm:leading-none" %>
      <%# 一份 HTML 兩種排法：640px 以上每個做法一欄，欄的外框是另外放進格線、跨三列的框；手機上依指標分兩組，每組兩格並排 %>
      <div class="grid max-w-[760px] grid-cols-2 gap-x-3 sm:gap-x-4">
        <% COLUMNS.each do |bound, column| %>
          <div aria-hidden="true" class="hidden rounded-xl border border-slate-200 sm:row-span-3 sm:row-start-1 sm:block <%= column %>"></div>
          <p class="hidden px-5.5 pt-5 pb-3 text-table font-semibold text-slate-700 sm:row-start-1 sm:block <%= column %>"><%= t(".#{bound}", minutes: @buffer_trade.minutes) %></p>
        <% end %>

        <p class="col-span-2 mb-2 font-semibold text-slate-700 sm:hidden"><%= t(".vehicle_hours") %></p>
        <% vehicle_hours.each do |bound, value| %>
          <div class="<%= cell %> sm:row-start-2 sm:border-b sm:border-slate-100 sm:pb-3 <%= COLUMNS.fetch(bound) %>">
            <span class="<%= bound_label %>"><%= t(".#{bound}", minutes: @buffer_trade.minutes) %></span>
            <span class="<%= metric_label %>"><%= t(".vehicle_hours") %></span>
            <span data-value="vehicle-hours-<%= bound %>" class="<%= figure %>"><%= decimal(value) %></span>
          </div>
        <% end %>

        <p class="col-span-2 mt-4.5 mb-2 font-semibold text-slate-700 sm:hidden"><%= t(".peak_vehicles") %></p>
        <% peaks.each do |bound, peak| %>
          <div data-peak="<%= bound %>" data-hour="<%= peak.hour %>" class="<%= cell %> sm:row-start-3 sm:pt-3 sm:pb-5 <%= COLUMNS.fetch(bound) %>">
            <span class="<%= bound_label %>"><%= t(".#{bound}", minutes: @buffer_trade.minutes) %></span>
            <span class="<%= metric_label %>"><%= t(".peak_vehicles") %></span>
            <span data-vehicles class="<%= figure %>"><%= decimal(peak.vehicles) %></span>
            <span class="text-label text-slate-500 sm:col-start-1 sm:row-start-2"><%= hour_span(peak.hour) %></span>
          </div>
        <% end %>
      </div>
      <p class="mt-3.5 max-w-[46em] text-note text-slate-500 sm:mt-3"><%= t(".bounds_note") %></p>

      <dl class="mt-5 grid grid-cols-2 gap-3 sm:mt-5.5 sm:flex sm:flex-wrap sm:gap-4">
        <div class="rounded-[10px] bg-slate-50 px-3.5 py-3 sm:flex-[0_1_300px] sm:rounded-xl sm:px-4.5 sm:py-3.5">
          <dt class="text-label leading-[1.45] text-slate-600 sm:text-note sm:leading-[1.65]"><%= t(".achieved", minutes: @buffer_trade.minutes) %></dt>
          <dd data-value="achieved" class="font-route-figure text-figure-minor-sm leading-[1.2] font-semibold text-slate-900 sm:text-figure-minor"><%= share(@buffer_trade.achieved_share) %></dd>
        </div>
        <div class="rounded-[10px] bg-slate-50 px-3.5 py-3 sm:flex-[0_1_300px] sm:rounded-xl sm:px-4.5 sm:py-3.5">
          <dt class="text-label leading-[1.45] text-slate-600 sm:text-note sm:leading-[1.65]"><%= t(".vehicles_per_day") %></dt>
          <dd data-value="vehicles-per-day" class="font-route-figure text-figure-minor-sm leading-[1.2] font-semibold text-slate-900 sm:text-figure-minor"><%= decimal(@buffer_trade.vehicles_per_day) %></dd>
        </div>
      </dl>
    <% else %>
      <p data-no-layover class="rounded border border-amber-300 bg-amber-50 p-4"><%= t(".no_layover") %></p>
    <% end %>
  </section>
</turbo-frame>
