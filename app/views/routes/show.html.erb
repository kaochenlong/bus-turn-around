<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Semi+Condensed:wght@500;600&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<% end %>
<%# 底色設在 body 上，layout 在頁面之後輸出的顯名聲明 footer 才會跟頁面同一個底色 %>
<% content_for :body_class, "bg-slate-50" %>

<main class="page-column flex flex-col gap-4 py-8 font-route text-body text-slate-800 [font-variant-numeric:tabular-nums] sm:gap-6">
  <%= render RouteCoverageComponent.new(coverage: @coverage) %>

  <% if @coverage.data? %>
    <% route_days = @coverage.route_days %>
    <%# 摘要的重點數字與折返停留表、捷運重疊表用同一個物件，數字只算一次 %>
    <% layover_stats = RoutePage::LayoverStats.new(route_days) %>
    <% load_profile = RoutePage::LoadProfile.new(route_days) %>
    <% mrt_overlap = RoutePage::MrtOverlap.new(route_days) %>
    <%# 同一張卡裡的區塊之間用這條分隔線 %>
    <% divider = tag.hr(class: "mt-7 mb-5 border-slate-200 sm:mt-8 sm:mb-6") %>
    <%= render RouteSummaryComponent.new(summary: RoutePage::Summary.new(route_days), layover_stats:, ends: @ends, mrt_overlap:) %>
    <%= render SectionNavComponent.new %>
    <%= render CardComponent.new(id: "layovers") do %>
      <%= render LayoverChartComponent.new(layover_distribution: RoutePage::LayoverDistribution.new(route_days), ends: @ends) %>
      <%= divider %>
      <%= render LayoverTableComponent.new(layover_stats:, ends: @ends) %>
    <% end %>
    <%# 卡片在 turbo-frame 外面：拉桿只重新載入卡片裡的這一塊 %>
    <%= render CardComponent.new(id: "buffer") do %>
      <%= render BufferTradeComponent.new(buffer_trade: RoutePage::BufferTrade.new(route_days, minutes: @buffer_minutes, ends: @ends), coverage: @coverage) %>
    <% end %>
    <%= render CardComponent.new(id: "runtimes") do %>
      <%= render RunTimeTableComponent.new(run_times: RoutePage::RunTimes.new(route_days)) %>
    <% end %>
    <%= render CardComponent.new(id: "load") do %>
      <%= render LoadChartComponent.new(load_profile:, mrt_overlap:) %>
      <%= divider %>
      <%= render MrtOverlapComponent.new(mrt_overlap:) %>
      <%= divider %>
      <%= render LoadProfileTableComponent.new(load_profile:) %>
    <% end %>
    <%= render CardComponent.new(id: "limits") do %>
      <%= render DataLimitationsComponent.new %>
    <% end %>
  <% end %>
</main>
