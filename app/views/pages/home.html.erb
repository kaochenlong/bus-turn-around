<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Semi+Condensed:wght@500;600&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<% end %>

<main class="page-column py-8 font-route text-body text-slate-800 [font-variant-numeric:tabular-nums]">
  <%= render HomeHeroComponent.new %>
  <%= render RouteListComponent.new(route_list: @route_list) %>
  <%= render DataLimitationsComponent.new(scope: :home) %>
  <%= render DataSourcesComponent.new %>
</main>
