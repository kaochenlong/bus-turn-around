<!DOCTYPE html>
<!--
   ____________________________________________
  |  ___    ___    ___    ___    ___    ___  | \
  | |   |  |   |  |   |  |   |  |   |  |   | |  \
  | |___|  |___|  |___|  |___|  |___|  |___| |___\
  |                                          |   |
  |  TurnAround                              |  o|
  |____/ \______________________/ \__________|___|
       \_/                      \_/
-->
<html>
  <head>
    <title><%= content_for(:title) || t("site.name") %></title>
    <meta name="description" content="<%= t("site.description") %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= t("site.name") %>">
    <meta property="og:title" content="<%= content_for(:title) || t("site.name") %>">
    <meta property="og:description" content="<%= t("site.description") %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= image_url("/turnaround/og-image-v2.jpg") %>">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= t("site.share_image_alt") %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:title) || t("site.name") %>">
    <meta name="twitter:description" content="<%= t("site.description") %>">
    <meta name="twitter:image" content="<%= image_url("/turnaround/og-image-v2.jpg") %>">
    <meta name="twitter:image:alt" content="<%= t("site.share_image_alt") %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("site.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/turnaround/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/turnaround/icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/turnaround/icon-16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/turnaround/apple-touch-icon.png" sizes="180x180">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= vite_assets %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <%= render SiteBarComponent.new %>
    <%= yield %>
    <%= render AttributionComponent.new %>
  </body>
</html>
