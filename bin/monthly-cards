#!/usr/bin/env ruby
# Prints the month cards production lacks and stores them there, as
# MonthlyCardsCommand describes: without arguments it only prints the plan. The
# target is production, so any other RAILS_ENV stops here, before Rails is loaded.
# Like bin/nightly-load, the machine that runs it has no credentials key: Rails gets
# a dummy secret_key_base, which this process never signs anything with, the
# database password comes from WEBSITE_DATABASE_PASSWORD and the database connection
# goes to the local end of the ssh port forward, TUNNEL_PORT.
ENV["RAILS_ENV"] ||= "production"
unless ENV["RAILS_ENV"] == "production"
  warn("bin/monthly-cards 寫的是正式站，RAILS_ENV 要是 production，現在是 #{ENV['RAILS_ENV']}")
  exit 1
end
ENV["SECRET_KEY_BASE_DUMMY"] ||= "1" unless ENV["SECRET_KEY_BASE"]
ENV["DB_HOST"] ||= "127.0.0.1"
ENV["DB_PORT"] ||= ENV.fetch("TUNNEL_PORT", "15432")

require_relative "../config/environment"
exit MonthlyCardsCommand.new(ARGV, env: ENV.to_h).run
